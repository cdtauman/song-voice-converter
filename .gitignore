# ── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.uv/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage

# ── מודלי AI (גדולים מדי ל-git) ────────────────────
*.pth
*.ckpt
*.onnx
*.safetensors
*.index
*.th
models/
checkpoints/

# ── שמע: לא מעלים חומר מוגן לריפו ──────────────────
*.wav
*.mp3
*.flac
*.m4a
*.ogg
*.aac
testdata/
benchmark/audio/
tests/fixtures/
# תוצאות בנצ'מרק: השמע לא נכנס, אבל המספרים כן —
# הם העדות שעליה מסתמכות ההחלטות. (הסדר כאן חשוב: git לא נכנס
# לתיקייה שכולה מוחרגת, ולכן צריך להחריג קבצים ולא את התיקייה.)
benchmark/results/**
!benchmark/results/**/
!benchmark/results/**/results.json

# ── פלט ריצה ───────────────────────────────────────
cache/
logs/
*.log
out/
tmp/
temp/

# ── Compatibility Spike ────────────────────────────
# סביבות הניסוי ענקיות; התוצאות עצמן כן נשמרות בגיט
spike/.venvs/
spike/last-run.log

# Phase-10 benchmark engines and checkouts are intentionally local-only.  The
# coordinator/adapters are tracked; every third-party runtime stays isolated.
env-bench/runtimes/
env-bench/.venv/

# ── אריזה ──────────────────────────────────────────
packaging/build/
packaging/output/
*.exe
*.msi

# ── מערכת הפעלה ועורכים ────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp

# ── סודות והגדרות מקומיות ──────────────────────────
.env
.env.*
local_settings.toml
